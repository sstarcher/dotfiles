find-envs () {
  file='envs.sh'
  dir=$(pwd)
  while [[ "$dir" != "" ]]; do
    if [[ -f "$dir/$file" ]]; then
        source "$dir/$file"
    fi
    dir=${dir%/*}
  done
}

